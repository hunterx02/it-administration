# انسخ الملف ده باسم .env في نفس الفولدر (ملف .env مش بيتشارك ولا بيترفع على Git)
# ممنوع تكتب هنا كلمات مرور أجهزة أو مفاتيح Google — دي بتتحط في مخزن أسرار منفصل لاحقًا.

ITADM_ENV=local
# مكان قاعدة البيانات المحلية (SQLite). عند النقل لـ VPS: postgresql+psycopg://user@host/db
# ITADM_DATABASE_URL=sqlite:///D:/IT_Administration_Project/it-administration-next/backend/data/itadmin.db
# ITADM_DATA_DIR=D:/IT_Administration_Project/it-administration-next/backend/data
ITADM_SESSION_HOURS=12
# true فقط لما يكون التشغيل على HTTPS (VPS)
ITADM_COOKIE_SECURE=false
